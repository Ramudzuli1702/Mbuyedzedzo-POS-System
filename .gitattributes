# Normalize all text to LF in the repository; check out native on each OS.
* text=auto

# Source and config always LF
*.java   text eol=lf
*.xml    text eol=lf
*.sql    text eol=lf
*.md     text eol=lf
*.properties text eol=lf
*.iss    text eol=lf
*.config text eol=lf

# Windows-only launchers stay CRLF
*.bat    text eol=crlf

# Binaries
*.ico    binary
*.jar    binary
*.msi    binary
*.png    binary
*.jpg    binary
*.pdf    binary
*.xlsx   binary
