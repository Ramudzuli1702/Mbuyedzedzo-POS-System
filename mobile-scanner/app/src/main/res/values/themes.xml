<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Light, not DayNight: the whole colour palette (colors.xml) only ever
        defines light-mode values — there's no values-night override, so this
        app was never actually designed to support dark mode. Under DayNight,
        a phone with system dark mode on made Material's default dark
        surface colours leak into anything that didn't hardcode a colour
        itself (a TextInputLayout's box fill, a MaterialCardView with no
        explicit cardBackgroundColor) — that's what made the Add Product
        form look solid black. Pinning to Light makes every screen behave
        the same regardless of the phone's system setting.
    -->
    <style name="Theme.POSScanner" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorAccent">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <style name="Theme.POSScanner.Fullscreen" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/black</item>
    </style>

    <!-- Compact icon-leading action row used on the home screen -->
    <style name="ActionRow" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>
</resources>
