<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingHorizontal="12dp" android:minHeight="56dp" android:background="@color/brand_primary">
        <com.google.android.material.button.MaterialButton android:id="@+id/stocktakeBack" style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="48dp" android:text="@string/back" android:textColor="@color/white" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/stocktaking" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" />

    </LinearLayout>
    <ProgressBar android:id="@+id/stocktakeProgress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" android:visibility="gone" />
    <TextView android:id="@+id/stocktakeStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="16dp" android:text="@string/stocktake_login_hint" android:textColor="@color/brand_primary_dark"
        android:background="@color/brand_primary_light" android:accessibilityLiveRegion="polite" />
    <LinearLayout android:id="@+id/stocktakeCountPanel" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="16dp" android:visibility="gone">
        <TextView android:id="@+id/stocktakeSummary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingVertical="12dp" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/ink" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/search_inventory">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/stocktakeSearch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:singleLine="true" android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/stocktakeScan" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/scan_product_barcode" android:textAllCaps="false" app:icon="@drawable/ic_inventory" app:cornerRadius="10dp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/stocktakeItems" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingVertical="8dp" />
        <TextView android:id="@+id/stocktakeEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/no_inventory_matches" android:padding="16dp" android:textColor="@color/muted" android:visibility="gone" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/count_notes">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/stocktakeNotes" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:maxLength="1000" android:maxLines="2" android:inputType="textMultiLine|textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/stocktakeSubmit" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/submit_for_approval" android:textAllCaps="false" app:cornerRadius="10dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/stocktakeNew" style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/start_fresh_count" android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
